# Copy to .env and adjust. Every var is optional unless marked REQUIRED;
# provider knobs are validated (with defaults) in
# src/server/infrastructure/config.ts.

# --- Core ----------------------------------------------------------------
# REQUIRED
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debt-master

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# App display name used in auth emails and 2FA flows (default: Debt Master)
PUBLIC_APP_NAME=

# --- Admin auth ------------------------------------------------------------
# better-auth (default) = email/password admin login; authentik = OAuth via a
# self-hosted Authentik instance. Colleague access-code login is independent
# of this setting.
AUTH_PROVIDER=better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Only when AUTH_PROVIDER=authentik
AUTHENTIK_BASE_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:3000/auth/callback
AUTHENTIK_SCOPE=openid profile email

# --- Legacy JWT sessions ---------------------------------------------------
JWT_SECRET=
JWT_EXPIRY_DAYS=

# --- Email (SMTP) ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENABLE_EMAIL_VERIFICATION=

# --- Object storage --------------------------------------------------------
# minio (default) = S3-compatible object storage; localfs = files on disk
# served through the cookie-gated /api/storage/ route (no MinIO needed).
STORAGE_PROVIDER=localfs
LOCALFS_ROOT_DIR=./storage
LOCALFS_BUCKET=debt-master
LOCALFS_PUBLIC_BASE_URL=
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=debt-master

# --- Cache -----------------------------------------------------------------
# inmemory | valkey. Unset, the backend auto-selects: valkey in production or
# when any VALKEY_* var is set, otherwise inmemory.
CACHE_PROVIDER=inmemory
VALKEY_URL=
VALKEY_HOST=
VALKEY_PORT=
VALKEY_PASSWORD=

# --- First-run setup -------------------------------------------------------
# Shared secret for the setup wizard (`/setup`). When set, a matching token
# authorizes first-run setup from ANY network (including public/remote hosts);
# when unset, setup works only from private/loopback addresses.
SETUP_TOKEN=

# --- Hardening knobs --------------------------------------------------------
# Reverse-proxy hops to trust when resolving the client IP from
# X-Forwarded-For. The RIGHTMOST hop is trusted; raise this only when you run
# additional internal proxies (default 1).
TRUSTED_PROXY_HOPS=

# Legacy full storage read for UNBOUND access codes. Outside production this
# defaults to allowed; in production it DENIES unless set to "true". Prefer
# binding codes to colleagues (assignAccessCodeColleague) instead.
ALLOW_UNBOUND_CODE_READ=

# Request-body cap enforced by the HTTP server before buffering, in MB
# (default 64 — headroom above the 20 MB upload limit).
MAX_BODY_SIZE_MB=

# --- Seeding ----------------------------------------------------------------
# Seed policy (see scripts/migrate.sh): "true" always seeds (incl. production),
# "false" never seeds; unset seeds outside production only. Production seed
# plants shared access codes and demo data — leave unset in production.
SEED_ON_START=

# --- Feature flags ---------------------------------------------------------
# Enable two-factor authentication for admin accounts ("true" / "false")
ENABLE_2FA=

# --- Cloudflare Turnstile --------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Test-only (never set in production) -----------------------------------
RUN_INTEGRATION_TESTS=
TEST_ADMIN_ACCESS_CODE=
TEST_SKIP_RATE_LIMIT=

# --- Sentry / GlitchTip error reporting -------------------------------------
# Public DSN injected by the infra repo (GlitchTip project per app). Without
# it the SDK is inert. Never a secret — safe to expose client-side.
SENTRY_DSN=
