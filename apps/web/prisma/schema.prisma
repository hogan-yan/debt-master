generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String?
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model AccessCode {
  id          Int        @id @default(autoincrement())
  code        String
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  createdBy   String?    @map("created_by")
  lastUsed    DateTime?  @map("last_used")
  deletedAt   DateTime?  @map("deleted_at")
  colleagueId Int?       @map("colleague_id")
  colleague   Colleague? @relation(fields: [colleagueId], references: [id])

  // Partial unique index access_codes_code_active_key (code WHERE deleted_at IS NULL)
  // lives in the SQL migration — Prisma does not model partial uniques.

  @@index([colleagueId])
  @@map("access_codes")
}

model Colleague {
  id                  Int                  @id @default(autoincrement())
  name                String
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           Int?                 @map("deleted_by")
  createdAt           DateTime             @default(now()) @map("created_at")
  accessCodes         AccessCode[]
  expenseItems        ExpenseItem[]
  expenseParticipants ExpenseParticipant[]
  payments            Payment[]

  @@map("colleagues")
}

model Restaurant {
  id        Int       @id @default(autoincrement())
  name      String
  address   String?
  cuisine   String?   @db.VarChar(50)
  notes     String?   @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  expenses  Expense[]
  payments  Payment[]

  @@map("restaurants")
}

model Expense {
  id               Int                  @id @default(autoincrement())
  date             DateTime             @db.Date
  restaurantId     Int                  @map("restaurant_id")
  amount           Decimal              @db.Decimal(10, 2)
  receiptObjectKey String?              @map("receipt_object_key")
  receiptBucket    String?              @map("receipt_bucket")
  splitType        String               @map("split_type")
  createdAt        DateTime             @default(now()) @map("created_at")
  createdBy        String?              @map("created_by")
  notes            String?
  items            ExpenseItem[]
  participants     ExpenseParticipant[]
  restaurant       Restaurant           @relation(fields: [restaurantId], references: [id])
  payments         Payment[]
  paymentApplications PaymentApplication[]

  @@index([restaurantId])
  // Every expense list orders by date; without this index each page is a filesort.
  @@index([date])
  @@map("expenses")
}

model ExpenseParticipant {
  id          Int                  @id @default(autoincrement())
  expenseId   Int                  @map("expense_id")
  colleagueId Int                  @map("colleague_id")
  amount      Decimal              @db.Decimal(10, 2)
  colleague   Colleague            @relation(fields: [colleagueId], references: [id])
  expense     Expense              @relation(fields: [expenseId], references: [id])
  paymentApplications PaymentApplication[]

  // Unique (expenseId, colleagueId) covers lookups by expenseId alone.
  @@unique([expenseId, colleagueId])
  @@index([colleagueId])
  @@map("expense_participants")
}

model ExpenseItem {
  id          Int       @id @default(autoincrement())
  expenseId   Int       @map("expense_id")
  name        String
  price       Decimal   @db.Decimal(10, 2)
  colleagueId Int       @map("colleague_id")
  colleague   Colleague @relation(fields: [colleagueId], references: [id])
  expense     Expense   @relation(fields: [expenseId], references: [id])

  @@index([expenseId])
  @@index([colleagueId])
  @@map("expense_items")
}

model Payment {
  id                    Int                  @id @default(autoincrement())
  colleagueId           Int                  @map("colleague_id")
  amount                Decimal              @db.Decimal(10, 2)
  date                  DateTime             @db.Date
  paymentType           String               @map("payment_type")
  restaurantId          Int?                 @map("restaurant_id")
  expenseId             Int?                 @map("expense_id")
  receiptObjectKey      String?              @map("receipt_object_key")
  receiptBucket         String?              @map("receipt_bucket")
  paymentProofBucket    String?              @map("payment_proof_bucket")
  paymentProofObjectKey String?              @map("payment_proof_object_key")
  isApproved            Boolean              @default(false) @map("is_approved")
  submittedAt           DateTime?            @map("submitted_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  createdBy             String?              @map("created_by")
  colleague             Colleague            @relation(fields: [colleagueId], references: [id])
  restaurant            Restaurant?          @relation(fields: [restaurantId], references: [id])
  expense               Expense?             @relation(fields: [expenseId], references: [id])
  applications          PaymentApplication[]

  @@index([colleagueId, isApproved])
  @@index([isApproved])
  @@index([expenseId])
  @@index([restaurantId])
  @@map("payments")
}

model PaymentApplication {
  id            Int                @id @default(autoincrement())
  paymentId     Int                @map("payment_id")
  expenseId     Int                @map("expense_id")
  participantId Int                @map("participant_id")
  amount        Decimal            @db.Decimal(10, 2)
  appliedAt     DateTime           @default(now()) @map("applied_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  payment       Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expense       Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant   ExpenseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // Unique (paymentId, participantId) covers lookups by paymentId alone.
  @@unique([paymentId, participantId])
  @@index([expenseId])
  @@index([participantId])
  @@map("payment_applications")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  userId    String   @map("user_id")
  details   Json?    @map("details")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─── Better Auth tables (DEBTCOM-2) ─────────────────────────────────────────
// Separate from the existing `User` model (Authentik/access-code admins) so the
// email/password login path is non-breaking. Better Auth's Prisma adapter reads
// these via the configured `modelName`s in `better-auth-instance.ts`.
// IDs are string (Better Auth default). Cascade deletes keep sessions/accounts
// consistent when a user is removed.

model BetterAuthUser {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  sessions        Session[]
  accounts        Account[]
  twoFactor       TwoFactor?

  @@map("better_auth_users")
}

model TwoFactor {
  id                      String         @id
  secret                  String
  backupCodes             String         @map("backup_codes")
  userId                  String         @unique @map("user_id")
  verified                Boolean        @default(true)
  // better-auth's two-factor plugin writes these on create/update; without
  // the columns Prisma rejects the write with "Unknown argument".
  failedVerificationCount Int            @default(0) @map("failed_verification_count")
  lockedUntil             DateTime?      @map("locked_until")
  user                    BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // userId @unique already indexes the column.
  @@map("two_factor")
}

model Session {
  id           String         @id
  token        String         @unique
  expiresAt    DateTime       @map("expires_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")
  userId       String         @map("user_id")
  user         BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("better_auth_sessions")
}

model Account {
  id                    String         @id
  accountId             String         @map("account_id")
  providerId            String         @map("provider_id")
  userId                String         @map("user_id")
  accessToken           String?        @map("access_token")
  refreshToken          String?        @map("refresh_token")
  idToken               String?        @map("id_token")
  accessTokenExpiresAt  DateTime?      @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?      @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  user                  BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("better_auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("better_auth_verifications")
}
