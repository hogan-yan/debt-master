# Debt Master self-host configuration — copy to .env and fill in.
# Postgres credentials (compose creates the database with these).
POSTGRES_PASSWORD=change-me
# Auth/session signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Legacy session signing secret — the server refuses to boot without it.
# Generate: openssl rand -base64 32
JWT_SECRET=change-me
# Public origin users will visit (no trailing slash).
PUBLIC_APP_URL=http://localhost:3000
# Host port to expose the app on.
PORT=3000
# true = empty database on first start; set false only to load demo data.
SKIP_SEED=true

# --- Optional ---------------------------------------------------------------
# Shared secret for the /setup first-run wizard. When set, a matching token
# authorizes setup from ANY network — required on public PaaS hosts like
# PikaPods. Unset, the wizard is usable only from private/loopback network
# addresses until the first admin exists.
# SETUP_TOKEN=
# Outbound SMTP for verification/reset emails (admin login works without it).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
