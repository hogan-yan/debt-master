{
  "name": "@debtmaster/web",
  "version": "1.0.0",
  "private": true,
  "description": "Selfhost expense-tracking web app (TanStack Start + React + Prisma)",
  "license": "MIT",
  "author": "Hogan",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-sitemap.mjs && vite dev",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url cookie baseLocale --emit-ts-declarations --output-structure locale-modules",
    "build": "node scripts/generate-sitemap.mjs && bun run paraglide:compile && node scripts/fix-paraglide-exports.js && vite build",
    "start": "vite start",
    "preview": "bun run build && bun run ./scripts/server.ts",
    "typecheck": "bun run paraglide:compile && tsc --noEmit",
    "typecov": "type-coverage -p tsconfig.json -i 'src/paraglide/**' -i 'src/routeTree.gen.ts' -i '**/*.generated.ts' --at-least 99.5",
    "knip": "DATABASE_URL=postgresql://knip knip",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run --no-file-parallelism src/server/expenses.integration.test.ts src/server/payment-workflows.integration.test.ts src/server/payments/handlers.test.ts src/server/auth/handlers.test.ts src/server/expenses/claim-handlers.test.ts src/server/expenses/handlers.test.ts src/server/colleagues/handlers.test.ts",
    "test:e2e": "bun run tests/e2e/run-smoke.ts",
    "test:e2e:coverage": "bun run scripts/e2e-coverage.ts",
    "test:coverage:all": "bun run test:coverage && bun run test:e2e:coverage",
    "lint:testids": "grep -rn 'data-testid=\"' src/ --include='*.tsx' --include='*.ts' | grep -v 'test-ids.ts' | grep -v '.test.' && echo 'ERROR: bare data-testid strings found' && exit 1 || echo 'OK: no bare data-testid strings'",
    "i18n:check": "bun run scripts/validate-translations.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "bun run prisma/seed.ts",
    "create:admin": "bun run scripts/create-admin.ts",
    "reset:admin-password": "bun run scripts/reset-admin-password.ts",
    "test:e2e:pw": "playwright test",
    "lint:server-boundary": "sh scripts/check-server-boundary.sh"
  },
  "dependencies": {
    "@debtmaster/core": "workspace:*",
    "@inlang/paraglide-js": "^2.20.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-radio-group": "^1.4.2",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@remotion/player": "^4.0.523",
    "@sentry/bun": "^10.73.0",
    "@tanstack/form-core": "^1.33.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/start-server-core": "^1.169.16",
    "better-auth": "^1.6.23",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "minio": "^8.0.7",
    "nodemailer": "^9.0.3",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "remotion": "^4.0.523",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.4.0",
    "@types/jest-axe": "^3.5.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/postcss-load-config": "^3.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "knip": "^6.25.0",
    "otpauth": "^9.5.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "react-grab": "^0.1.48",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "sideEffects": false
}
